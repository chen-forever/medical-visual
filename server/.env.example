# 复制为 .env.local，填入你自己的 Key。不要提交 .env.local。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=8787
HOST=127.0.0.1
STATIC_DIR=../app/dist
# STATIC_DIR is resolved relative to the server directory.
# leave empty for server/data/qihuang.sqlite
DATABASE_PATH=
# 留空则本机不启用登录；设置后必须登录才能访问病例 API
APP_ACCESS_PASSWORD=
SESSION_SECRET=
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
